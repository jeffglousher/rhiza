apiVersion: chaos-mesh.org/v1alpha1
kind: PodChaos
metadata:
  name: rhiza-__RUN_ID__-pod-kill
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/part-of: rhiza-chaos
    chaos.rhiza.io/run: __RUN_ID__
spec:
  action: pod-kill
  mode: one
  duration: 30s
  selector:
    namespaces: [__NAMESPACE__]
    labelSelectors:
      app.kubernetes.io/part-of: rhiza-chaos
      chaos.rhiza.io/run: __RUN_ID__
      chaos.rhiza.io/role: __ROLE__
